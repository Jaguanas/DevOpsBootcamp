// Jenkinsfile for EC2 multibranch pipeline
pipeline {
    agent any

    parameters {
        choice(name: 'DEPLOY_TARGET', choices: ['current-instance', 'all-instances'], description: 'Deployment Target')
        booleanParam(name: 'RUN_HEALTH_CHECK', defaultValue: true, description: 'Run tests')
    }

    stages {
        stage('Prepare') {
            steps {
                script {
                    env.INSTANCE_ID = sh(returnStdout: true, script: '''
                        TOKEN=$(curl -sf -m 3 -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 60" || true)
                        curl -sf -m 3 -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id || echo unknown
                    ''').trim()

                    def b = env.BRANCH_NAME
                    env.BRANCH_TYPE = b.startsWith('feature/') ? 'feature' :
                                      b == 'ec2-development'   ? 'development' :
                                      b == 'ec2-staging'       ? 'staging' :
                                      b == 'main'              ? 'production' : 'other'
                }
                echo "Branch: ${env.BRANCH_NAME}"
                echo "Branch Type: ${env.BRANCH_TYPE}"
                echo "Instance ID: ${env.INSTANCE_ID}"
                echo "Deploy Target: ${params.DEPLOY_TARGET}"
            }
        }

        stage('Validate Scripts') {
            steps {
                sh '''
                    echo "=== Script Validation for ${BRANCH_TYPE} ==="
                    failed=0
                    for script in scripts/*.sh; do
                        [ -f "$script" ] || continue
                        if bash -n "$script"; then echo "OK    $script"; else echo "ERROR $script"; failed=1; fi
                    done
                    exit $failed
                '''
            }
        }

        stage('Test Scripts') {
            when { expression { params.RUN_HEALTH_CHECK } }
            parallel {
                stage('Syntax Tests') {
                    steps {
                        sh '''
                            bash -n scripts/ec2-info.sh    && echo "ec2-info.sh syntax OK"
                            bash -n scripts/health-check.sh && echo "health-check.sh syntax OK"
                        '''
                    }
                }
                stage('Functionality Tests') {
                    steps {
                        sh '''
                            chmod +x scripts/*.sh
                            timeout 30 ./scripts/ec2-info.sh > "$WORKSPACE/test-output.txt"
                            cat "$WORKSPACE/test-output.txt"
                            echo "Test completed"
                        '''
                    }
                }
            }
        }

        stage('Deploy to Development') {
            when {
                anyOf {
                    branch 'ec2-development'
                    branch 'feature/*'
                }
            }
            steps {
                sh '''
                    mkdir -p /opt/ec2-scripts/dev
                    cp scripts/*.sh /opt/ec2-scripts/dev/
                    echo "Development deployment completed"
                '''
            }
        }

        stage('Deploy to Staging') {
            when { branch 'ec2-staging' }
            steps {
                sh '''
                    mkdir -p /opt/ec2-scripts/staging
                    cp scripts/*.sh /opt/ec2-scripts/staging/
                    echo "Staging deployment completed"
                '''
            }
        }

        stage('Deploy to Production') {
            when { branch 'main' }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    input message: 'Deploy to Production Instance?', ok: 'Deploy'
                }
                sh '''
                    mkdir -p /opt/ec2-scripts/prod
                    cp scripts/*.sh /opt/ec2-scripts/prod/
                    chmod +x /opt/ec2-scripts/prod/*.sh
                    echo "Production deployment completed on ${INSTANCE_ID}"
                '''
            }
        }
    }

    post {
        always {
            echo "EC2 Pipeline completed for branch: ${env.BRANCH_NAME}"
            archiveArtifacts artifacts: 'scripts/*.sh', allowEmptyArchive: true
        }
        success { echo "Pipeline succeeded on instance ${env.INSTANCE_ID}!" }
        failure { echo "Pipeline failed on instance ${env.INSTANCE_ID}!" }
    }
}